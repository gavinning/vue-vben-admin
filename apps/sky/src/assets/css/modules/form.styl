// 表单混合布局
// Item1: 50%宽度, 两个Item2共占一行
// Item2: 100%宽度, 一个Item2独占一行
.form-container
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  margin: 0 auto

  .form-item1
    grid-column: span 1
    min-width: calc(50% - 5px)
    padding: 16px 20px

  .form-item2
    grid-column: 1 / -1
    padding: 16px 20px

  .form-switch
    height 32px

  p.text-muted-foreground.text-sm
    font-size 12px
    padding 6px 0
    color var(--el-text-color-secondary)

  // 文件上传限制1张
  // 上传1张后，会隐藏上传按钮
  .form-file-limit-1
    .el-upload-list__item + .el-upload
      visibility: hidden

/* 小屏幕单列 */
@media (max-width: 600px)
  .form-container
    grid-template-columns: 1fr

    .form-item1
      min-width: 100%
